{
  "name": "tinyweb-office-words",
  "version": "1.0.0",
  "description": "Lightweight free open-source document converter — convert DOCX, DOC, RTF to Markdown, text, and PDF",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./saving": {
      "types": "./dist/saving.d.ts",
      "default": "./dist/saving.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'",
    "release": "npm run build && npm test && npm publish --provenance --access public"
  },
  "keywords": [
    "docx",
    "doc",
    "rtf",
    "markdown",
    "pdf",
    "converter",
    "word",
    "document",
    "office"
  ],
  "license": "MIT",
  "author": "tinyweb-office-words contributors",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fast-xml-parser": "^4.5.1",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
